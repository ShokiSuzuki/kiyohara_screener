# Copy this file to `.env` and fill values before running locally or in container.
# Do NOT commit your real secrets to version control.

# EDINET API key (required)
EDINET_API_KEY=your_edinet_api_key_here

# Flask / app settings
FLASK_ENV=production
PORT=5000
SECRET_KEY=change_me

# Optional: Redis URL for job queue (if you later add RQ/Celery)
REDIS_URL=redis://localhost:6379/0
